# Optional front-end gate for the static demo. The value is inlined into the bundle.
# Leave it empty to keep the demo open. This is not real access control.
NEXT_PUBLIC_GATE_PASSWORD=

# Set by the GitHub Pages workflow. Leave empty for a domain-root host and for local dev.
# PAGES_BASE_PATH=/bot-routines-tracker

# Private site password. Server-side only. Never prefix it with NEXT_PUBLIC_.
# SITE_PASSWORD=

# Node server used by Vercel, Netlify, and your own machine. Loopback by default.
# Set SITE_PASSWORD before binding any other interface.
# HOST=127.0.0.1
# PORT=8788

# Export + upload. Shell variables for scripts/export-and-upload.sh, not Next.js.
# AGENTS_ROOT=/home/box/agent-data/agents
# SYNC_TARGET=r2
#   r2       private Cloudflare R2 (recommended when you deploy on Cloudflare)
#   file     a file outside public/ and out/
#   http     PUT a private https URL with ROUTINES_TOKEN
#   blob     private Vercel Blob
#   kv       Upstash or Vercel KV REST
#   netlify  Netlify Blobs (npm install @netlify/blobs)
# ROUTINES_TIMEZONE=Asia/Shanghai
# STALE_AFTER_MINUTES=45
# ROUTINES_OBJECT_KEY=routines.json

# If more than one store below is set, set FEED_SOURCE to url, file, blob, kv, or netlify.

# Cloudflare R2. Required only when SYNC_TARGET=r2. Do not enable public access or r2.dev.
# R2_BUCKET=bot-routines-data
# R2_CLI=wrangler

# Private URL. The token stays on the server. The browser never sees it.
# FEED_SOURCE=url
# ROUTINES_URL=https://example.com/private/routines.json
# ROUTINES_TOKEN=

# Private file. Must not be inside public/ or out/.
# FEED_SOURCE=file
# ROUTINES_FILE=/var/lib/bot-routines/routines.json

# Private Vercel Blob. Reads use the private host, never the public blob host.
# FEED_SOURCE=blob
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# KV REST. The JSON is the POST body, not part of the URL.
# FEED_SOURCE=kv
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=

# Netlify Blobs.
# FEED_SOURCE=netlify
# NETLIFY_SITE_ID=
# NETLIFY_BLOBS_TOKEN=
# ROUTINES_NETLIFY_STORE=routines
