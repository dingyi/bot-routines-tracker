{
  "name": "bot-routines-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Static dashboard template for scheduled bot routines.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server/index.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "cf-typegen": "wrangler types worker/env.d.ts --include-runtime false",
    "test": "tsx --test lib/*.test.ts worker/*.test.ts && node --test scripts/*.test.mjs server/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "croner": "^10.0.1",
    "cronstrue": "^3.32.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
